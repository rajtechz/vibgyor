:'verification',title:'8. Account Verification',content:"Get verified to increase your trust score and visibility. Upload a government ID and take a selfie to verify your identity. This helps create a safer community."},{id:'location-settings',title:'9. Location Settings',content:"Control your location visibility and search radius. You can hide your exact location while still showing your general area to potential matches."},{id:'notifications',title:'10. Notifications',content:"Customize your notification preferences. Choose what types of notifications you want to receive and how often you want to be notified about new matches and messages."},{id:'data-privacy',title:'11. Data Privacy',content:"Learn about how we protect your personal information, what data we collect, and how you can control your privacy settings. Your data is encrypted and secure."},{id:'contact-support',title:'12. Contact Support',content:"Need help? Contact our support team through the app, email, or live chat. We're available 24/7 to assist you with any questions or issues."}].filter(function(t){return t.title.toLowerCase().includes(h.toLowerCase())||t.content.toLowerCase().includes(h.toLowerCase())});return(0,s.jsxs)(r.default,{children:[(0,s.jsx)(i.StatusBar,{barStyle:"light-content",backgroundColor:"transparent",translucent:!0}),(0,s.jsxs)(i.View,{style:[c.header,{paddingTop:l.top}],children:[(0,s.jsx)(i.TouchableOpacity,{onPress:function(){return t.goBack()},style:c.backButton,children:(0,s.jsx)(_r(d[9]).BackIcon,{width:24,height:24,color:"#D9D8F3"})}),(0,s.jsx)(i.Text,{style:c.headerTitle,children:"Help Center"}),(0,s.jsx)(i.TouchableOpacity,{style:c.menuButton,children:(0,s.jsx)(_r(d[9]).TermsIcon,{width:24,height:24})})]}),(0,s.jsxs)(i.ScrollView,{style:c.scrollContainer,showsVerticalScrollIndicator:!1,children:[(0,s.jsx)(i.View,{style:c.searchContainer,children:(0,s.jsx)(i.TextInput,{style:c.searchInput,placeholder:"Search help articles...",placeholderTextColor:"#B0B0B0",value:h,onChan